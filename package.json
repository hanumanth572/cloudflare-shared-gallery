{
  "name": "shared-gallery",
  "private": true,
  "version": "1.0.0",
  "description": "Shared Gallery: serverless image gallery on Cloudflare Workers (Free plan)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.107.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
