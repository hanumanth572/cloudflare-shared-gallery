{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shared-gallery",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-08",
  // assets.directory is intentionally omitted: @cloudflare/vite-plugin infers it
  // from the client build output.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "shared-gallery-media" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-gallery-db",
      // Placeholder until the remote database is created with
      // `wrangler d1 create shared-gallery-db`. Local dev keys off the name.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "images": { "binding": "IMAGES" },
  "vars": { "SESSION_TTL_DAYS": "30" },
  "observability": { "enabled": true }
}
