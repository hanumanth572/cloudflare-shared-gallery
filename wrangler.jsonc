{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "shared-gallery",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-07-08",
	// assets.directory is intentionally omitted: @cloudflare/vite-plugin infers it
	// from the client build output.
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/media/*"
		]
	},
	"r2_buckets": [
  {
    "binding": "BUCKET",
    "bucket_name": "shared-gallery-media"
  }
],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shared-gallery-db",
			"database_id": "ec5b165b-06fb-416a-8536-79fedcda56aa",
			"migrations_dir": "migrations"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"SESSION_TTL_DAYS": "30"
	},
	"observability": {
		"enabled": true
	}
}